# DNS e HTTPS
APP_DOMAIN=app.seudominio.com.br
API_DOMAIN=api.seudominio.com.br
ACME_EMAIL=contato@seudominio.com.br

# PostgreSQL: gere uma senha nova com `openssl rand -hex 32`
POSTGRES_DB=ares
POSTGRES_USER=ares_app
POSTGRES_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Gere com `openssl rand -base64 48 | tr -d '\n'`
JWT_SECRET_BASE64=
JWT_ISSUER=ares-api

# Mantenha false até integrar uma cobrança real.
SUBSCRIPTION_PAYMENT_SIMULATION_ENABLED=false

# Documentação da API. Desative ambos depois, se não quiser Swagger público.
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Termos, privacidade e cupom
LEGAL_TERMS_VERSION=2026-08-27
LEGAL_PRIVACY_VERSION=2026-08-27
PROMOTION_COUPON_CODE=BEMVINDO20
PROMOTION_DISCOUNT_PERCENTAGE=20
PROMOTION_VALID_UNTIL=2026-12-31

# Estes valores são incorporados ao frontend durante o build.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=Nome empresarial ou nome completo
NEXT_PUBLIC_LEGAL_OPERATOR_DOCUMENT=CNPJ ou CPF
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=Endereço comercial
NEXT_PUBLIC_PRIVACY_EMAIL=privacidade@seudominio.com.br
NEXT_PUBLIC_LEGAL_TERMS_VERSION=2026-08-27
NEXT_PUBLIC_LEGAL_PRIVACY_VERSION=2026-08-27
